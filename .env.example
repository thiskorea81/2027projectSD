# 이 파일을 .env 로 복사해서 사용하세요:  cp .env.example .env
# .env 는 Git 에 올라가지 않습니다. 컴퓨터를 옮길 때는 따로 복사해야 합니다.

# --- PostgreSQL ---
POSTGRES_USER=school
POSTGRES_PASSWORD=change-me
POSTGRES_DB=school_notice

# --- 로컬 AI (Ollama) ---
# 기본: 맥미니에 직접 설치한 Ollama (GPU 가속). 앱 컨테이너가 아래 주소로 접속합니다.
OLLAMA_URL=http://host.docker.internal:11434
# 사용할 모델 이름. 맥미니 24GB 기준 12B 정도까지 여유 있게 돌아갑니다.
OLLAMA_MODEL=gemma3:12b
#
# Linux/NVIDIA 서버에서 컨테이너 Ollama 를 쓸 때만: 아래 주석을 풀고 위 OLLAMA_URL 을 지운 뒤,
# 아래 '외부 접속' 의 COMPOSE_PROFILES 에 ollama 를 추가하세요.
# OLLAMA_URL=http://ollama:11434
# 마지막 요청 후 모델을 메모리에 유지하는 시간 (컨테이너 Ollama 전용)
OLLAMA_KEEP_ALIVE=30m

# --- 첨부파일 ---
# 첨부파일을 저장할 맥미니의 폴더 (로컬 디스크)
UPLOADS_DIR=./data/uploads

# --- 부서 공문서 폴더 ---
# 부서별 하위 폴더(예: 교무부, 학생부 …)에 공문서를 내려받는 맥미니의 폴더.
# 앱에는 읽기 전용, 야간 워커에는 (월간 정리 때문에) 쓰기 가능으로 연결됩니다.
#   예) DOCUMENTS_DIR=/Users/school/공문서
DOCUMENTS_DIR=./data/documents

# --- 야간 작업 워커 ---
# 이 시간대에만 공문 처리(분류·담당자 지정 등)를 실행합니다. (자정을 넘겨도 됨)
WORKER_ACTIVE_FROM=18:00
WORKER_ACTIVE_UNTIL=08:00
# 활성 시간대에 새 문서를 확인하는 간격(분)
WORKER_INTERVAL_MINUTES=10
# 월간 정리: 매달 이 날짜 이후 첫 야간에 한 번, 기한이 남은 미처리 업무를 뺀 불필요한 자료를 삭제
CLEANUP_DAY_OF_MONTH=1
# true 면 실제로 지우지 않고 대상만 기록 (규칙을 충분히 확인한 뒤 false 로)
CLEANUP_DRY_RUN=true

# --- 백업 ---
# 1차 백업: 서버(맥미니) 안의 폴더
BACKUP_DIR=./backups
# 매일 백업 시각 (업무시간 외, 야간 공문 처리 뒤). 비우면 BACKUP_INTERVAL_HOURS 시간마다
BACKUP_TIME=03:00
BACKUP_INTERVAL_HOURS=24
# DB 백업 보관: 최근 7일치 + 일요일분 4주 + 매달 1일분 3개월 (최대 약 90일, 맥미니·NAS 동일)
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=3
# 2차 백업: NAS. DB 백업 복사 + 첨부파일·부서 공문 폴더 동기화. 맥에 마운트된 NAS 공유 폴더 경로 (비워 두면 안 함)
#   예) Mac: /Volumes/backup/school-notice   Linux: /mnt/nas/school-notice
# 그 폴더에 표식 파일 .school-notice-backup 을 한 번 만들어 두어야 합니다 (README 참고).
NAS_BACKUP_DIR=
# 원본에서 삭제된(월간 정리 포함) 첨부파일·공문을 NAS 에 남겨 두는 기간(일)
NAS_DELETED_KEEP_DAYS=90

# --- 접속 방법 (운영 배포 시에만 사용, docker-compose.prod.yml 과 함께) ---
#   lan    : 1단계(현재). 교내망에서 http://맥미니IP 로 접속
#   tunnel : 외부 공개. Cloudflare Tunnel (학교 방화벽 포트 개방 불필요)
#   caddy  : 외부 공개. 80/443 포트를 열어 직접 HTTPS 서비스
# 컨테이너 Ollama 도 쓰면 쉼표로 이어 씁니다. 예) COMPOSE_PROFILES=lan,ollama
COMPOSE_PROFILES=lan
# lan 방식에서 쓸 포트 (기본 80 → http://맥미니IP)
LAN_PORT=80

# tunnel 방식: Cloudflare 대시보드에서 발급한 터널 토큰
CLOUDFLARE_TUNNEL_TOKEN=

# caddy 방식: 접속 주소. 실제 도메인을 넣으면 HTTPS 인증서를 자동 발급합니다.
#   예) DOMAIN=notice.myschool.kr   (테스트: DOMAIN=localhost)
DOMAIN=localhost

# --- 호스트에 노출할 포트 (다른 프로그램과 겹치면 바꾸세요) ---
APP_PORT=3000
DB_PORT=5432
OLLAMA_PORT=11434
ADMINER_PORT=8080

# --- 개발 편의 ---
# Windows(Docker Desktop)에서 파일을 고쳐도 화면이 자동 갱신되지 않으면 true 로 바꾸세요.
WATCHPACK_POLLING=false

# --- 컨테이너 내부망 ---
# 학교망 주소와 겹치지 않는 대역 (학교망이 172.x 이므로 10.x 사용)
DOCKER_SUBNET=10.213.0.0/24
